# Keycloak Configuration for HMeet Frontend
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=hmeet
KEYCLOAK_CLIENT_ID=hmeet-frontend
# For public clients, no secret is required
# If you need to configure a backend client, add:
# KEYCLOAK_BACKEND_CLIENT_ID=hmeet-backend
# KEYCLOAK_BACKEND_CLIENT_SECRET=2Kux6kxJOGWbGNN9sm7NqHoOObK9MY8m