# Keycloak Configuration for HMeet Frontend
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=hmeet
VITE_KEYCLOAK_CLIENT_ID=hmeet-frontend
VITE_REST_API_BASE_URL=http://localhost:3000/api
